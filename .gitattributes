# Enforce consistent line endings and encoding across platforms (Windows/Mac/Linux)
* text=auto eol=lf

# Explicitly mark text file types
*.md text eol=lf
*.mdx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.env text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.conf text eol=lf

# Binary files — do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
*.csv binary
