# DeerFlow 镜像源配置
# 使用方法：cp .env.mirrors .env.mirrors.local 并修改后使用
# 或在 docker compose 命令前指定：--env-file .env.mirrors.local
#
# 取消注释需要的镜像源，注释掉默认值即可切换

# ── Debian APT 镜像 ─────────────────────────────────────────────────────
# 阿里云（推荐）
APT_MIRROR=mirrors.aliyun.com
# 清华大学
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# 中科大
# APT_MIRROR=mirrors.ustc.edu.cn
# 网易
# APT_MIRROR=mirrors.163.com
# 官方（默认，速度慢）
# APT_MIRROR=

# ── npm/pnpm 镜像 ────────────────────────────────────────────────────────
# 淘宝 npmmirror（推荐）
NPM_REGISTRY=https://registry.npmmirror.com
# 腾讯云
# NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
# 官方（默认，速度慢）
# NPM_REGISTRY=

# ── PyPI/uv 镜像 ─────────────────────────────────────────────────────────
# 清华大学（推荐）
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 阿里云
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 中科大
# UV_INDEX_URL=https://pypi.mirrors.ustc.edu.cn/simple/
# 官方（默认，速度慢）
# UV_INDEX_URL=https://pypi.org/simple

# ── UV 工具镜像 ──────────────────────────────────────────────────────────
# 原始地址（通过代理或直连）
UV_IMAGE=ghcr.io/astral-sh/uv:0.7.20
# Docker Hub 镜像加速
# UV_IMAGE=ghcr.dockerproxy.com/astral-sh/uv:0.7.20
# 其他代理
# UV_IMAGE=mirror.gcr.io/astral-sh/uv:0.7.20

# ── Docker Hub 镜像 ──────────────────────────────────────────────────────
# 配置 Docker daemon 的 registry-mirrors 使用以下任一地址：
# https://docker.1ms.run
# https://docker.xuanyuan.me
# https://docker.hpcloud.cloud
# https://mirror.ccs.tencentyun.com
# https://registry.docker-cn.com
# 然后在 /etc/docker/daemon.json 中配置:
# {
#   "registry-mirrors": ["https://docker.1ms.run"]
# }

# ── pnpm 存储路径 ────────────────────────────────────────────────────────
PNPM_STORE_PATH=/root/.local/share/pnpm/store
