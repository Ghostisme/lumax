      },
      {
        "path": "data.video_list[].item_id",
        "field": "item_id",
        "label": "抖音视频ID",
        "type": "string",
        "description": "抖音视频ID",
        "display": "default"
      },
      {
        "path": "data.video_list[].title",
        "field": "title",
        "label": "视频标题",
        "type": "string",
        "description": "视频标题",
        "display": "default"
      },
      {
        "path": "data.video_list[].video_id",
        "field": "video_id",
        "label": "视频ID",
        "type": "string",
        "description": "视频ID",
        "display": "diagnostic"
      },
      {
        "path": "data.video_list[].aweme_id",
        "field": "aweme_id",
        "label": "抖音号id",
        "type": "string",
