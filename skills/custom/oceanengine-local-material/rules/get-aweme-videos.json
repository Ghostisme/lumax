      },
      {
        "path": "data.video_list[].image_mode",
        "field": "image_mode",
        "label": "视频格式",
        "type": "string",
        "description": "视频格式 可选值: IMAGE_MODE_LOCAL_ADGRAPHIC 团购卡 IMAGE_MODE_VIDEO 横版视频 IMAGE_MODE_VIDEO_VERTICAL 竖版视频",
