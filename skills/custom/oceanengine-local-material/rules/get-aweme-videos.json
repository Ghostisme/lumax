      {
        "path": "data.video_list[].cover_image_url",
        "field": "cover_image_url",
        "label": "视频封面图片地址",
        "type": "string",
        "description": "视频封面图片地址",
        "display": "diagnostic"
      },
      {
        "path": "data.video_list[].aweme_video_url",
        "field": "aweme_video_url",
        "label": "视频播放地址",
        "type": "string",
        "description": "视频播放地址",
        "display": "diagnostic"
      },
      {
        "path": "data.video_list[].not_delivery_reason[]",
        "field": "not_delivery_reason",
        "label": "不可投放原因",
