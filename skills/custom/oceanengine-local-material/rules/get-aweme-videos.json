      },
      {
        "path": "data.page_info.cursor",
        "field": "cursor",
        "label": "页码游标值",
        "type": "string",
        "description": "页码游标值",
        "display": "diagnostic"
      },
      {
        "path": "data.page_info.has_more",
        "field": "has_more",
        "label": "是否有下一页",
        "type": "bool",
        "description": "是否有下一页",
        "display": "default"
      },
      {
        "path": "request_id",
        "field": "request_id",
        "label": "请求日志id",
        "type": "string",
        "description": "请求日志id",
        "display": "diagnostic"
      }
    ]
  },
  "mcp_tool_name": "localFileVideoAwemeGet",
  "match_tokens": [
    "local",
    "file",
    "video",
    "aweme",
    "get",
    "获取抖音主页视频"
  ],
  "required": [
    "local_account_id",
    "cursor",
    "filtering",
    "filtering.anchor_info",
    "filtering.anchor_info.anchor_types"
  ],
  "field_labels": {
    "local_account_id": "本地推账号ID",
    "cursor": "分页游标",
    "filtering": "过滤条件",
    "filtering.anchor_info": "挂载信息",
    "filtering.anchor_info.anchor_types": "挂载类型列表",
    "filtering.anchor_info.poi_ids": "门店ID列表",
    "filtering.anchor_info.product_ids": "商品ID列表",
    "filtering.aweme_ids": "抖音号ID列表",
    "filtering.item_ids": "视频 item_id 列表",
    "filtering.item_status": "素材状态",
    "filtering.start_time": "筛选开始时间",
    "filtering.end_time": "筛选结束时间",
    "external_action": "优化目标",
    "order_field": "排序字段",
    "page_size": "每页数量"
  },
  "fields": {
    "local_account_id": {
      "type": "number"
    },
    "cursor": {
      "type": "string"
    },
    "filtering": {
      "type": "object"
    },
    "filtering.anchor_info": {
      "type": "object"
    },
    "filtering.anchor_info.anchor_types": {
      "type": "array",
      "min_items": 1
    },
    "filtering.anchor_info.anchor_types[]": {
      "type": "string",
      "enum": [
        "ALL_ANCHOR",
        "POI_ANCHOR",
        "PRODUCT_ANCHOR"
      ],
      "enum_labels": {
        "ALL_ANCHOR": "全部挂载",
        "POI_ANCHOR": "门店挂载",
        "PRODUCT_ANCHOR": "商品挂载"
      }
    },
    "filtering.anchor_info.poi_ids": {
      "type": "array",
      "min_items": 1
    },
    "filtering.anchor_info.product_ids": {
      "type": "array",
      "min_items": 1
    },
    "filtering.aweme_ids": {
      "type": "array"
    },
    "filtering.item_ids": {
      "type": "array",
      "max_items": 10
    },
    "filtering.item_status": {
      "type": "string",
      "enum": [
        "ALL",
        "VALID"
      ],
      "enum_labels": {
        "ALL": "全部",
        "VALID": "有效"
      }
    },
    "filtering.start_time": {
      "type": "string"
    },
    "filtering.end_time": {
      "type": "string"
    },
    "external_action": {
      "type": "string",
      "enum": [
        "OTO_PAY",
        "POI_RECOMMEND"
      ],
      "enum_labels": {
        "OTO_PAY": "团购购买",
        "POI_RECOMMEND": "门店引流"
      }
    },
    "order_field": {
      "type": "string",
      "enum": [
        "ARRIVE_SHOP",
        "ESTIMATE",
        "LIKE_CNT",
        "PAY_ORDER_CNT",
        "PUBLISH_TIME"
      ],
      "enum_labels": {
        "ARRIVE_SHOP": "到店",
        "ESTIMATE": "预估",
        "LIKE_CNT": "点赞数",
        "PAY_ORDER_CNT": "支付订单数",
        "PUBLISH_TIME": "发布时间"
      }
    },
    "page_size": {
      "type": "integer",
      "min": 1,
      "max": 100
    }
  },
  "conditional_required": [
    {
      "when": {
        "field": "filtering.anchor_info.anchor_types[]",
        "equals": "POI_ANCHOR"
      },
      "fields": [
        "filtering.anchor_info.poi_ids"
      ],
      "message": "anchor_types 包含 POI_ANCHOR 时需要提供门店ID列表"
    },
    {
      "when": {
        "field": "filtering.anchor_info.anchor_types[]",
        "equals": "PRODUCT_ANCHOR"
      },
      "fields": [
        "filtering.anchor_info.product_ids"
      ],
      "message": "anchor_types 包含 PRODUCT_ANCHOR 时需要提供商品ID列表"
    },
    {
      "when": {
        "field": "filtering.anchor_info.anchor_types[]",
        "equals": "ALL_ANCHOR"
      },
      "fields": [
        "filtering.aweme_ids"
      ],
      "message": "anchor_types 包含 ALL_ANCHOR 时需要提供抖音号ID列表"
    }
  ],
  "forbidden_when": [],
  "mcp_wrap_request": true
}
