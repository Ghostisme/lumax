      {
        "path": "data.video_list[].lego_material_id",
        "field": "lego_material_id",
        "label": "素材id",
        "type": "number",
        "description": "素材id",
        "display": "diagnostic"
      },
      {
        "path": "data.video_list[].video_width",
        "field": "video_width",
        "label": "视频宽度",
        "type": "number",
        "description": "视频宽度",
        "display": "diagnostic"
      },
      {
        "path": "data.video_list[].video_heigh",
        "field": "video_heigh",
        "label": "视频高度",
        "type": "number",
        "description": "视频高度",
        "display": "diagnostic"
      },
      {
        "path": "data.page_info",
        "field": "page_info",
        "label": "分页信息",
        "type": "object",
        "description": "分页信息",
