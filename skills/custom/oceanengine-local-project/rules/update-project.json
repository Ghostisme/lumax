        "marketing_goal": "VIDEO_IMAGE"
      },
      "fields": [
        "delivery_goal"
      ],
      "message": "短视频或图文项目必须填写投放内容"
    },
    {
      "when": {
        "marketing_goal": "VIDEO_IMAGE",
        "delivery_goal": "POI"
      },
      "fields": [
        "delivery_poi_mode"
      ],
      "message": "短视频或图文推门店项目必须填写是否投放全部门店"
    },
    {
      "when": {
        "delivery_goal": "POI",
        "delivery_poi_mode": "PART"
      },
      "fields": [
        "promotion_poi_ids"
      ],
      "message": "投放指定门店时必须填写推门店ID列表"
    },
    {
      "when": {
        "marketing_goal": "VIDEO_IMAGE",
        "delivery_goal": "PRODUCT"
      },
      "fields": [
        "product_id"
      ],
      "message": "投放商品时必须填写商品投放ID"
    },
    {
      "when": {
        "marketing_goal": "LIVE",
        "local_delivery_scene": "CONTENT_HEAT"
      },
      "fields": [
        "aweme_id"
      ],
      "message": "直播线上互动需要填写用于投放直播间的抖音号"
    },
    {
      "when": {
        "marketing_goal": "LIVE",
        "local_delivery_scene": "PRODUCT_PAY"
      },
      "fields": [
        "aweme_id"
      ],
      "message": "直播团购成交需要填写用于投放直播间的抖音号"
    },
    {
      "when": {
        "local_delivery_scene": "EXTERNAL"
      },
      "fields": [
        "external_action"
      ],
      "message": "获取线索场景必须填写优化目标"
    },
    {
      "when": {
        "schedule_type": "FIXED_TIME"
      },
      "fields": [
        "schedule_fixed_seconds"
      ],
      "message": "固定时长投放必须填写直播固定投放时长"
    },
    {
      "when": {
        "schedule_type": "START_TO_END"
      },
      "fields": [
        "end_time"
      ],
      "message": "设置结束时间时必须填写结束投放时间"
    },
    {
      "when": {
        "field": "end_time",
        "exists": true
      },
      "fields": [
        "schedule_type"
      ],
      "message": "更新投放开始或结束时间时必须填写投放日期类型设置"
    },
    {
      "when": {
        "marketing_goal": "VIDEO_IMAGE",
        "local_delivery_scene": [
          "POI_RECOMMEND",
          "PRODUCT_PAY"
        ]
      },
      "fields": [
        "is_set_peak_budget"
      ],
      "message": "短视频线下到店或团购成交项目必须填写高峰日预算设置"
    },
    {
      "when": {
        "is_set_peak_budget": true
      },
      "fields": [
        "high_budget_rate"
      ],
      "message": "开启高峰日预算时必须填写高峰日预算上调比例"
    }
  ],
  "forbidden_when": [
    {
      "when": {
        "marketing_goal": "VIDEO_IMAGE",
        "local_delivery_scene": "CONTENT_HEAT",
        "ad_type": "SEARCHING"
      },
      "fields": [
        "ad_type"
      ],
      "message": "短视频或图文线上互动不支持搜索单元"
    },
    {
      "when": {
        "local_delivery_scene": "EXTERNAL",
        "ad_type": "SEARCHING"
      },
      "fields": [
        "ad_type"
      ],
      "message": "获取线索场景不支持搜索单元"
    },
    {
      "when": {
        "local_delivery_scene": "EXTERNAL"
      },
      "fields": [
        "aweme_id"
      ],
      "message": "获取线索场景不支持传入抖音号"
    },
    {
      "when": {
        "marketing_goal": "VIDEO_IMAGE",
        "local_delivery_scene": [
          "POI_RECOMMEND",
          "PRODUCT_PAY"
        ]
      },
      "fields": [
        "external_action"
      ],
      "message": "短视频或图文线下到店或团购成交场景不支持传入优化目标"
    },
    {
      "when": {
        "schedule_type": "FIXED_TIME"
      },
      "fields": [
        "schedule_time"
      ],
      "message": "固定时长投放不支持传入投放时段"
    }
  ],
  "mcp_value_maps": {
    "budgetMode": {
      "DAY": "BUDGET_MODE_DAY",
      "TOTAL": "BUDGET_MODE_TOTAL",
      "ALL": "ALL"
    }
  },
  "mcp_wrap_request": true,
  "confirmation": {
    "enabled": true,
    "query_capability": "get-project-detail",
    "max_retries": 3,
    "mode": "project_detail",
    "fields": [
      "name",
      "end_time",
      "schedule_time",
      "bid_type",
      "bid",
      "budget",
