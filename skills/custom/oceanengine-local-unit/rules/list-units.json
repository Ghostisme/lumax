        "path": "data.page_info.total_number",
        "field": "total_number",
        "label": "总数",
        "type": "number",
        "description": "总数",
        "display": "default"
      },
      {
        "path": "data.page_info.total_page",
        "field": "total_page",
        "label": "总页数",
        "type": "number",
        "description": "总页数",
        "display": "diagnostic"
      },
      {
        "path": "request_id",
        "field": "request_id",
        "label": "请求日志id",
        "type": "string",
        "description": "请求日志id",
        "display": "diagnostic"
      }
    ]
