      {
        "path": "data.promotion_list[].learning_phase",
        "field": "learning_phase",
        "label": "学习期状态",
        "type": "string",
        "description": "学习期状态，枚举值：LEARNED 学习期结束；LEARNING 学习中；LEARN_FAILED 学习失败",
