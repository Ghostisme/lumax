{
  "schema_version": 1,
  "name": "batch-example",
  "title": "批量示例",
  "operation_type": "batch",
  "mcp": {
    "server": "platform-agent-biz",
    "tool": "exampleBatchMutation",
    "field_map": {
      "account_id": "accountId",
      "items": "items"
    }
  },
  "parameters": [
    {
      "name": "account_id",
      "label": "账户 ID",
      "type": "integer",
      "required": true
    },
    {
      "name": "items",
      "label": "批量项",
      "type": "array",
      "required": true
    }
  ],
  "batch": {
    "field": "items",
    "item_identifier": "resource_id",
    "item_schema": {
      "parameters": [
        {
          "name": "resource_id",
          "label": "资源 ID",
          "type": "integer",
          "required": true
        },
        {
          "name": "status",
          "label": "目标状态",
          "type": "string",
          "required": true,
          "enum": ["ENABLE", "DISABLE"],
          "enum_labels": {
            "ENABLE": "启用",
            "DISABLE": "暂停"
          }
        }
      ],
      "constraints": []
    }
  },
  "confirmation": {
    "enabled": true,
    "query_capability": "read-example",
    "match_fields": ["items[].status"],
    "max_retries": 3
  },
  "output": {
    "success_fields": ["items[].resource_id", "items[].status"]
  }
}
