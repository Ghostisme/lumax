{
  "schema_version": 1,
  "name": "mutation-example",
  "title": "增删改示例",
  "operation_type": "mutation",
  "mcp": {
    "server": "platform-agent-biz",
    "tool": "exampleMutation",
    "field_map": {
      "account_id": "accountId",
      "resource_id": "resourceId"
    }
  },
  "parameters": [
    {
      "name": "account_id",
      "label": "账户 ID",
      "type": "integer",
      "required": true
    },
    {
      "name": "resource_id",
      "label": "资源 ID",
      "type": "integer",
      "required": true
    },
    {
      "name": "status",
      "label": "目标状态",
      "type": "string",
      "required": true,
      "enum": ["ENABLE", "DISABLE"],
      "enum_labels": {
        "ENABLE": "启用",
        "DISABLE": "暂停"
      }
    }
  ],
  "constraints": [
    {
      "type": "forbidden_when",
      "when": {
        "field": "status",
        "equals": "ENABLE"
      },
      "fields": []
    }
  ],
  "confirmation": {
    "enabled": true,
    "query_capability": "read-example",
    "match_fields": ["status"],
    "max_retries": 3
  },
  "output": {
    "success_fields": ["resource_id", "status"]
  }
}
